# ── Claude AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Z-API (WhatsApp) ────────────────────────────────────────────────────────
# Painel: https://app.z-api.io → sua instância → Credenciais
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_SECURITY_TOKEN=SEU_SECURITY_TOKEN   # necessário para validar webhooks

# ── GetNet (pagamentos) ─────────────────────────────────────────────────────
# Painel: https://developers.getnet.com.br
GETNET_CLIENT_ID=SEU_CLIENT_ID
GETNET_CLIENT_SECRET=SEU_CLIENT_SECRET
GETNET_SELLER_ID=SEU_SELLER_ID
GETNET_ENV=sandbox   # sandbox | production

# ── Simples PMS ──────────────────────────────────────────────────────────────
# Solicite as credenciais de API ao suporte do Simples Hotelaria
SIMPLES_API_URL=https://api.simpleshotelaria.com.br
SIMPLES_API_KEY=SUA_API_KEY
SIMPLES_HOTEL_ID=SEU_HOTEL_ID

# ── Hotel ───────────────────────────────────────────────────────────────────
HOTEL_NOME="Hotel Paradise"
HOTEL_ENDERECO="Rua das Flores, 123 - São Paulo/SP"
HOTEL_TELEFONE="+55 11 99999-9999"
HOTEL_EMAIL="contato@hotelparadise.com.br"
HOTEL_CHECK_IN="14:00"
HOTEL_CHECK_OUT="12:00"
HOTEL_PIX_CHAVE="11.999.999/0001-99"   # CNPJ, CPF, e-mail ou celular do Pix

# ── Bot ─────────────────────────────────────────────────────────────────────
PORT=3000
# URL pública do bot para configurar no webhook da Z-API
# Ex: https://meubot.com/webhook  ou  https://abc123.ngrok.io/webhook
WEBHOOK_URL=https://SEU_DOMINIO/webhook
