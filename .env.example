# Database
DATABASE_URL="postgresql://hotel:hotelpass@localhost:5432/hotel_ai"

# Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# WhatsApp (Z-API - most popular in Brazil)
ZAPI_INSTANCE_ID=your_instance_id
ZAPI_TOKEN=your_token
ZAPI_SECURITY_TOKEN=your_security_token
ZAPI_BASE_URL=https://api.z-api.io

# Also support Twilio
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# App
PORT=3001
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:3000
WHATSAPP_PROVIDER=zapi  # zapi | twilio | meta

# Hotel Config
HOTEL_NAME="Hotel Paradise"
HOTEL_PHONE="+55 11 99999-9999"
HOTEL_EMAIL="contato@hotelparadise.com.br"
HOTEL_ADDRESS="Rua das Flores, 123 - São Paulo/SP"
HOTEL_CHECK_IN_TIME="14:00"
HOTEL_CHECK_OUT_TIME="12:00"

# Redis
REDIS_URL="redis://localhost:6379"

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
