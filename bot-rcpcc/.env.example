# ===== Claude (obrigatório) =====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ===== Digisac (obrigatório) =====
# URL da sua conta, ex.: https://suaempresa.digisac.app/api/v1
DIGISAC_API_URL=https://SUACONTA.digisac.app/api/v1
DIGISAC_TOKEN=token-gerado-em-configuracoes-api
# ID da conexão (WhatsApp) que o robô atende
DIGISAC_SERVICE_ID=
# Departamento para onde o lead qualificado é transferido (opcional)
DIGISAC_DEPARTAMENTO_ADVOGADO_ID=
# Segredo que você coloca na URL do webhook: https://seu-servidor/webhook/digisac?secret=XXX
WEBHOOK_SECRET=troque-por-um-texto-aleatorio-longo

# ===== Origem do lead (quando o robô roda o fluxo RCPCC) =====
# Opção mais confiável: um número/conexão só para a campanha. Cole aqui o serviceId dela.
RCPCC_SERVICE_IDS=
# Texto pré-preenchido do link do anúncio + palavras-chave (vírgula; acento e maiúscula não importam)
RCPCC_GATILHOS=#rcpcc,revisar meu contrato,revisao de contrato,revisional,juros abusivos,juros altos
# IDs dos anúncios Click-to-WhatsApp (só funciona se o Digisac repassar o referral no webhook)
RCPCC_AD_IDS=
# Quem NÃO veio do criativo: triagem (robô tria e encaminha por área) | silencio (robô não responde)
OUTRAS_AREAS_MODO=triagem
# Departamento do Digisac por área (rode python -m app.diagnostico para ver os IDs)
DEPARTAMENTOS_POR_AREA={"consumidor":"","trabalhista":"","defesa_execucao":"","imobiliario":""}

# ===== Avisos para o advogado =====
# WhatsApp que recebe o resumo de cada lead qualificado (só números, com DDI)
ADVOGADO_WHATSAPP=5511999999999

# ===== Áudio (opcional) =====
# Transcrição (ouvir áudio): Groq Whisper - barato e rápido. Sem chave = robô pede para escrever.
GROQ_API_KEY=
# Voz (mandar áudio): ElevenLabs. Sem chave = robô só responde em texto.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== Agenda (opcional; sem isso o robô oferece o link abaixo) =====
GOOGLE_SERVICE_ACCOUNT_JSON=/app/data/google-sa.json
GOOGLE_CALENDAR_ID=seuemail@gmail.com
LINK_AGENDAMENTO_FALLBACK=
# Reuniões são sempre online e gratuitas: link fixo da sua sala
LINK_REUNIAO_ONLINE=https://meet.google.com/xxx-xxxx-xxx
HORARIO_INICIO=9
HORARIO_FIM=18
DURACAO_REUNIAO_MIN=30
FUSO=America/Sao_Paulo

# ===== Escritório =====
NOME_ESCRITORIO=RZ Advocacia
NOME_ADVOGADO=Dr. Rodrigo
NOME_ASSISTENTE=Ana
