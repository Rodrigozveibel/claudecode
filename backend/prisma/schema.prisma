generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  ACCOUNTANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_ORDER
  HOUSEKEEPING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  DIRECT
  BOOKING_COM
  EXPEDIA
  AIRBNB
  HOTEL_WEBSITE
  PHONE
  WALK_IN
  OTHER
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  PIX
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum HousekeepingTaskType {
  CHECKOUT_CLEANING
  STAYOVER_CLEANING
  DEEP_CLEANING
  TURNDOWN
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
  ISSUE_REPORTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RateType {
  BASE
  SEASONAL
  WEEKEND
  PROMOTION
  LAST_MINUTE
  EARLY_BIRD
}

enum ChannelName {
  BOOKING_COM
  EXPEDIA
  AIRBNB
  HOTELS_COM
  OTHER
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  APP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  role       UserRole @default(FRONT_DESK)
  propertyId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property              Property?              @relation(fields: [propertyId], references: [id])
  housekeepingTasks     HousekeepingTask[]     @relation("AssignedHousekeeping")
  inspectedTasks        HousekeepingTask[]     @relation("InspectedHousekeeping")
  maintenanceReported   MaintenanceRequest[]   @relation("ReportedMaintenance")
  maintenanceAssigned   MaintenanceRequest[]   @relation("AssignedMaintenance")
  notifications         Notification[]
  auditLogs             AuditLog[]
  reservationsCreated   Reservation[]          @relation("CreatedReservations")
  paymentsProcessed     Payment[]

  @@map("users")
}

model Property {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  address      String
  city         String
  state        String?
  country      String
  zipCode      String?
  phone        String
  email        String
  website      String?
  logo         String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("12:00")
  policies     String?
  amenities    Json?
  starRating   Int?
  taxRate      Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  roomTypes           RoomType[]
  rooms               Room[]
  guests              Guest[]
  reservations        Reservation[]
  payments            Payment[]
  invoices            Invoice[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  rateRules           RateRule[]
  channelMappings     ChannelMapping[]
  notifications       Notification[]
  guestMessages       GuestMessage[]
  auditLogs           AuditLog[]

  @@map("properties")
}

model RoomType {
  id           String   @id @default(uuid())
  propertyId   String
  name         String
  description  String?
  maxOccupancy Int
  maxAdults    Int
  maxChildren  Int      @default(0)
  size         Float?
  amenities    Json?
  photos       Json?
  basePrice    Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property       Property        @relation(fields: [propertyId], references: [id])
  rooms          Room[]
  reservations   Reservation[]
  rateRules      RateRule[]
  channelMappings ChannelMapping[]

  @@map("room_types")
}

model Room {
  id         String     @id @default(uuid())
  propertyId String
  roomTypeId String
  number     String
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  isActive   Boolean    @default(true)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id])
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id])
  reservations        Reservation[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([propertyId, number])
  @@map("rooms")
}

model Guest {
  id             String    @id @default(uuid())
  propertyId     String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  document       String?
  documentType   String?
  nationality    String?
  birthDate      DateTime?
  address        String?
  city           String?
  country        String?
  preferences    Json?
  notes          String?
  blacklisted    Boolean   @default(false)
  totalStays     Int       @default(0)
  totalSpent     Float     @default(0)
  loyaltyPoints  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property             Property              @relation(fields: [propertyId], references: [id])
  reservations         Reservation[]
  payments             Payment[]
  invoices             Invoice[]
  guestMessages        GuestMessage[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@map("guests")
}

model Reservation {
  id                 String            @id @default(uuid())
  propertyId         String
  roomId             String?
  roomTypeId         String
  guestId            String
  confirmationNumber String            @unique
  status             ReservationStatus @default(PENDING)
  checkIn            DateTime
  checkOut           DateTime
  adults             Int               @default(1)
  children           Int               @default(0)
  nightsCount        Int
  roomRate           Float
  totalAmount        Float
  paidAmount         Float             @default(0)
  source             ReservationSource @default(DIRECT)
  channelBookingId   String?
  specialRequests    String?
  internalNotes      String?
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  property         Property           @relation(fields: [propertyId], references: [id])
  room             Room?              @relation(fields: [roomId], references: [id])
  roomType         RoomType           @relation(fields: [roomTypeId], references: [id])
  guest            Guest              @relation(fields: [guestId], references: [id])
  creator          User?              @relation("CreatedReservations", fields: [createdBy], references: [id])
  addons           ReservationAddon[]
  payments         Payment[]
  invoices         Invoice[]
  guestMessages    GuestMessage[]
  loyaltyTx        LoyaltyTransaction[]

  @@map("reservations")
}

model ReservationAddon {
  id            String   @id @default(uuid())
  reservationId String
  name          String
  quantity      Int      @default(1)
  unitPrice     Float
  total         Float
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_addons")
}

model Payment {
  id            String        @id @default(uuid())
  reservationId String?
  guestId       String
  propertyId    String
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  notes         String?
  processedBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  guest        Guest        @relation(fields: [guestId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  processor    User?        @relation(fields: [processedBy], references: [id])

  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid())
  reservationId String?
  guestId       String
  propertyId    String
  number        String        @unique
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float
  taxes         Float         @default(0)
  discounts     Float         @default(0)
  total         Float
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservation Reservation?  @relation(fields: [reservationId], references: [id])
  guest       Guest         @relation(fields: [guestId], references: [id])
  property    Property      @relation(fields: [propertyId], references: [id])
  items       InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model HousekeepingTask {
  id            String                 @id @default(uuid())
  propertyId    String
  roomId        String
  assignedTo    String?
  type          HousekeepingTaskType
  status        HousekeepingTaskStatus @default(PENDING)
  priority      Priority               @default(MEDIUM)
  scheduledDate DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  notes         String?
  inspectedBy   String?
  inspectedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  property   Property @relation(fields: [propertyId], references: [id])
  room       Room     @relation(fields: [roomId], references: [id])
  assignee   User?    @relation("AssignedHousekeeping", fields: [assignedTo], references: [id])
  inspector  User?    @relation("InspectedHousekeeping", fields: [inspectedBy], references: [id])

  @@map("housekeeping_tasks")
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  propertyId  String
  roomId      String?
  reportedBy  String?
  assignedTo  String?
  title       String
  description String
  category    String
  status      MaintenanceStatus @default(OPEN)
  priority    Priority          @default(MEDIUM)
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])
  reporter User?    @relation("ReportedMaintenance", fields: [reportedBy], references: [id])
  assignee User?    @relation("AssignedMaintenance", fields: [assignedTo], references: [id])

  @@map("maintenance_requests")
}

model RateRule {
  id         String   @id @default(uuid())
  propertyId String
  roomTypeId String?
  name       String
  rateType   RateType
  amount     Float
  minNights  Int?
  startDate  DateTime?
  endDate    DateTime?
  daysOfWeek Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property  @relation(fields: [propertyId], references: [id])
  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  @@map("rate_rules")
}

model ChannelMapping {
  id                 String      @id @default(uuid())
  propertyId         String
  channelName        ChannelName
  externalPropertyId String?
  externalRoomId     String?
  roomTypeId         String?
  markup             Float       @default(0)
  isActive           Boolean     @default(true)
  lastSync           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  property Property  @relation(fields: [propertyId], references: [id])
  roomType RoomType? @relation(fields: [roomTypeId], references: [id])

  @@map("channel_mappings")
}

model Notification {
  id         String   @id @default(uuid())
  propertyId String?
  userId     String
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  data       Json?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model GuestMessage {
  id            String           @id @default(uuid())
  propertyId    String
  guestId       String
  reservationId String?
  channel       MessageChannel
  direction     MessageDirection
  subject       String?
  body          String
  status        MessageStatus    @default(SENT)
  sentAt        DateTime?
  createdAt     DateTime         @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@map("guest_messages")
}

model LoyaltyTransaction {
  id            String                 @id @default(uuid())
  guestId       String
  reservationId String?
  type          LoyaltyTransactionType
  points        Int
  description   String?
  createdAt     DateTime               @default(now())

  guest       Guest        @relation(fields: [guestId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@map("loyalty_transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  propertyId String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
